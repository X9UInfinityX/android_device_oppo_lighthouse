     </com.android.settingslib.widget.UntitledPreferenceCategory>
 
     <com.android.settingslib.widget.UntitledPreferenceCategory
diff --git a/src/com/android/settings/homepage/PlusKeyPreferenceController.java b/src/com/android/settings/homepage/PlusKeyPreferenceController.java
new file mode 100644
index 0000000..157937d
--- /dev/null
+++ b/src/com/android/settings/homepage/PlusKeyPreferenceController.java
@@ -0,0 +1,41 @@
