+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="24"
+    android:viewportHeight="24"
+    android:tint="?android:attr/colorControlNormal">
+
+    <path
+        android:fillColor="@android:color/white"
+        android:pathData="M7,7h10c2.76,0 5,2.24 5,5s-2.24,5 -5,5H7c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5zM7,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3h10c1.66,0 3,-1.34 3,-3s-1.34,-3 -3,-3H7z" />
+
+    <path
+        android:fillColor="@android:color/white"
+        android:pathData="M10,11h4v2h-4z" />
