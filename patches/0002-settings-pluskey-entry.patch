+
+package com.android.settings.homepage;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+
+import com.android.settings.core.BasePreferenceController;
+
+public class PlusKeyPreferenceController extends BasePreferenceController {
+    private static final Intent PLUS_KEY_SETTINGS = new Intent(
+            "com.oplus.pluskey.SETTINGS").setPackage("com.oplus.pluskey");
+
+    public PlusKeyPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        ResolveInfo info = mContext.getPackageManager().resolveActivity(
+                PLUS_KEY_SETTINGS, PackageManager.MATCH_SYSTEM_ONLY);
+        return info != null && info.activityInfo.applicationInfo.isPrivilegedApp()
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+}
